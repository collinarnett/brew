+<?php
+
+namespace App\Http\Middleware;
+
+use App\Models\User\User;
+use Closure;
+use Illuminate\Http\Request;
+use Illuminate\Support\Facades\Auth;
+
+/**
+ * Signs in the user the reverse proxy has already authenticated.
+ *
+ * The proxy supplies that user's address as the MONICA_PROXY_EMAIL FastCGI
+ * parameter. Client headers only ever reach PHP as HTTP_* parameters, so no
+ * request can supply this one itself.
+ */
+class AuthenticateFromProxy
+{
+    public function handle(Request $request, Closure $next)
+    {
+        $email = $request->server('MONICA_PROXY_EMAIL');
+
+        if (is_string($email) && $email !== '') {
+            $current = Auth::user();
+
+            if ($current === null || strcasecmp($current->email, $email) !== 0) {
+                $user = User::where('email', $email)->first();
+
+                if ($user !== null) {
+                    Auth::login($user);
+                } elseif ($current !== null) {
+                    Auth::logout();
+                }
+            }
+        }
+
+        return $next($request);
+    }
+}
