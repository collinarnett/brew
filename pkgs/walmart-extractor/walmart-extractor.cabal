cabal-version:   3.0
name:            walmart-extractor
version:         0.1.0
synopsis:        Maintenance CLI for the Walmart persisted query catalog
license:         MIT
build-type:      Simple

executable walmart-extractor
  default-language: GHC2021
  default-extensions: DerivingStrategies StrictData
  ghc-options:      -Wall -Wcompat -Wextra -Wunused-packages -Werror
                    -threaded -fwrite-ide-info -hiedir=.hie
  main-is:          Main.hs
  hs-source-dirs:   app
  build-depends:    base >= 4.17 && < 5
                  , aeson
                  , aeson-pretty
                  , browser-cookies
                  , bytestring
                  , http-client
                  , http-client-tls
                  , text
                  , walmart
