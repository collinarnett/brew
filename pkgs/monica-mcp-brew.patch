+// Reads and changes are separate tools, so a client can let reading run on
+// its own while every change asks first. Each tool keeps its name for its
+// list, get and search actions; the rest move to the same name plus _edit.
+const READ_ACTIONS = new Set(["list", "get", "search"]);
+
+function splitByAccess(t: Tool<any>): Tool<any>[] {
+  if (!(t.input instanceof z.ZodDiscriminatedUnion)) return [t];
+  const options = t.input.options as z.ZodObject<any>[];
+  const isRead = (o: z.ZodObject<any>) => READ_ACTIONS.has(o.shape.action.value);
+  const reads = options.filter(isRead);
+  const writes = options.filter((o) => !isRead(o));
+  const input = (os: z.ZodObject<any>[]) => (os.length === 1 ? os[0] : z.discriminatedUnion("action", os as any));
+  if (writes.length === 0) return [{ ...t, annotations: { ...t.annotations, ...READS } }];
+  if (reads.length === 0) return [{ ...t, annotations: { ...t.annotations, ...WRITES } }];
+  return [
+    {
+      ...t,
+      input: input(reads),
+      annotations: { ...t.annotations, ...READS },
+      description: `${t.description}\nThis tool only reads (list, get, search); ${t.name}_edit makes every change.`,
+    },
+    {
+      ...t,
+      name: `${t.name}_edit`,
+      input: input(writes),
+      annotations: { ...t.annotations, ...WRITES },
+      description: `${t.description}\nThis tool only makes changes; ${t.name} reads.`,
+    },
+  ];
+}
+
+export const TOOLS: Tool<any>[] = BASE_TOOLS.flatMap(splitByAccess);
+
