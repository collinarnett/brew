cabal-version:   3.0
name:            walmart-mcp
version:         0.1.0
synopsis:        MCP server exposing the walmart library as tools
license:         MIT
build-type:      Simple

common opts
  default-language: GHC2021
  default-extensions: DerivingStrategies OverloadedStrings StrictData
  ghc-options:      -Wall -Wcompat -Wextra -Wunused-packages -Werror
                    -fwrite-ide-info -hiedir=.hie

library
  import:           opts
  hs-source-dirs:   src
  exposed-modules:  WalmartMcp
                  , WalmartMcp.Config
  build-depends:    base >= 4.17 && < 5
                  , aeson
                  , browser-cookies
                  , bytestring
                  , directory
                  , filepath
                  , mcp-server
                  , text
                  , time
                  , toml-parser
                  , walmart

executable walmart-mcp
  import:           opts
  main-is:          Main.hs
  hs-source-dirs:   app
  ghc-options:      -threaded
  build-depends:    base >= 4.17 && < 5
                  , walmart-mcp
                  , mcp-server
