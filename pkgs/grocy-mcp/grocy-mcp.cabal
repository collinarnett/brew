cabal-version:   3.0
name:            grocy-mcp
version:         0.1.0
synopsis:        MCP server exposing the grocy library as tools
license:         MIT
build-type:      Simple

common opts
  default-language: GHC2021
  default-extensions: DerivingStrategies OverloadedStrings StrictData
  ghc-options:      -Wall -Wcompat -Wextra -Wunused-packages -Werror
                    -fwrite-ide-info -hiedir=.hie

library
  import:           opts
  hs-source-dirs:   src
  exposed-modules:  GrocyMcp
                  , GrocyMcp.Config
  build-depends:    base >= 4.17 && < 5
                  , aeson
                  , bytestring
                  , directory
                  , filepath
                  , grocy
                  , mcp-server
                  , safe-money
                  , scientific
                  , text
                  , time
                  , toml-parser

executable grocy-mcp
  import:           opts
  main-is:          Main.hs
  hs-source-dirs:   app
  ghc-options:      -threaded
  build-depends:    base >= 4.17 && < 5
                  , grocy-mcp
                  , grocy
                  , mcp-server
