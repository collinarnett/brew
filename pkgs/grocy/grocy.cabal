cabal-version:   3.0
name:            grocy
version:         0.1.0
synopsis:        Grocy REST API client
license:         MIT
build-type:      Simple
extra-source-files: test/corpus/*.json

library
  default-language: GHC2021
  default-extensions: DataKinds DerivingStrategies StrictData
  ghc-options:      -Wall -Wcompat -Wextra -Wunused-packages -Werror
                    -fwrite-ide-info -hiedir=.hie
  hs-source-dirs:   src
  exposed-modules:  Grocy
  build-depends:    base >= 4.17 && < 5
                  , aeson
                  , bytestring
                  , http-client
                  , http-client-tls
                  , http-types
                  , safe-money
                  , scientific
                  , text
                  , time

test-suite tests
  default-language: GHC2021
  default-extensions: DerivingStrategies OverloadedStrings StrictData
  ghc-options:      -Wall -Wcompat -Wextra -Wunused-packages -Werror
  type:             exitcode-stdio-1.0
  main-is:          Main.hs
  hs-source-dirs:   test
  build-depends:    base >= 4.17 && < 5
                  , aeson
                  , filepath
                  , grocy
                  , tasty
                  , tasty-hunit
                  , time
